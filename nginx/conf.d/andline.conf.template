server {
    listen ${SERVER_PORT};
    server_name _;

    root ${APP_DIR}/public;
    index index.php index.html;
    charset utf-8;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # AndBridge plugin endpoint: wss://domain/bridge
    location = ${ANDBRIDGE_GATEWAY_PATH} {
        proxy_pass http://127.0.0.1:${ANDBRIDGE_GATEWAY_PORT};
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $andline_forwarded_proto;

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }

    # Both public Vue SPA and /admin are Laravel Blade shells.
    # Built files are emitted under public/assets by Laravel Mix.
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;

        include /etc/nginx/fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $document_root;
        fastcgi_param HTTP_X_FORWARDED_PROTO $andline_forwarded_proto;
        fastcgi_param HTTPS $andline_fastcgi_https;

        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        fastcgi_read_timeout 120s;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
